{
  "schemaVersion": 1,
  "id": "example-agent-research",
  "name": "Agent research",
  "description": "Scripted parallel research by two agents, followed by review and a progress metric.",
  "nodes": [
    {
      "id": "planner",
      "moduleType": "agent.worker",
      "label": "Research planner",
      "position": { "x": 0, "y": 130 },
      "config": { "role": "Planner", "task": "Split the question" }
    },
    {
      "id": "web",
      "moduleType": "agent.worker",
      "label": "Web researcher",
      "position": { "x": 270, "y": 0 },
      "config": { "role": "Web research", "task": "Find public sources" }
    },
    {
      "id": "docs",
      "moduleType": "agent.worker",
      "label": "Document researcher",
      "position": { "x": 270, "y": 260 },
      "config": {
        "role": "Document research",
        "task": "Examine supplied files"
      }
    },
    {
      "id": "review",
      "moduleType": "basic.process",
      "label": "Synthesis & review",
      "position": { "x": 580, "y": 130 },
      "config": { "description": "Compare findings before presenting" }
    },
    {
      "id": "progress",
      "moduleType": "utility.metric",
      "label": "Progress",
      "position": { "x": 880, "y": 130 },
      "config": { "initialValue": 0, "unit": "%" }
    }
  ],
  "edges": [
    {
      "id": "planner-web",
      "sourceNodeId": "planner",
      "sourcePortId": "out",
      "targetNodeId": "web",
      "targetPortId": "in"
    },
    {
      "id": "planner-docs",
      "sourceNodeId": "planner",
      "sourcePortId": "out",
      "targetNodeId": "docs",
      "targetPortId": "in"
    },
    {
      "id": "web-review",
      "sourceNodeId": "web",
      "sourcePortId": "out",
      "targetNodeId": "review",
      "targetPortId": "in"
    },
    {
      "id": "docs-review",
      "sourceNodeId": "docs",
      "sourcePortId": "out",
      "targetNodeId": "review",
      "targetPortId": "in"
    }
  ],
  "scenarios": [
    {
      "id": "research-demo",
      "name": "Parallel research",
      "durationMs": 3000,
      "events": [
        {
          "id": "r1",
          "atMs": 0,
          "type": "node.status",
          "nodeId": "planner",
          "status": "active"
        },
        {
          "id": "r2",
          "atMs": 0,
          "type": "metric.set",
          "nodeId": "progress",
          "value": 0
        },
        {
          "id": "r3",
          "atMs": 0,
          "type": "log.append",
          "message": "Planner divides the work",
          "level": "info",
          "nodeId": "planner"
        },
        {
          "id": "r4",
          "atMs": 500,
